{
  "name": "dsh-article-review",
  "version": "0.2.2-alpha.16",
  "description": "Annotation-driven Markdown manuscript review with proposals and human review baselines",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "paper-review",
    "markdown",
    "manuscript",
    "annotations"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Biogod2020/dsh-article-review.git"
  },
  "homepage": "https://github.com/Biogod2020/dsh-article-review#readme",
  "bugs": {
    "url": "https://github.com/Biogod2020/dsh-article-review/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.0-rc.2 || 0.2.1-alpha.4 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.2-alpha.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "skills/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/node-addon-system": "^0.1.2",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5-alpha.2 || ~3.18.6-alpha.1",
    "diff": "9.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5-alpha.2 || ~4.0.6-alpha.1",
    "@deepseek-ai/dsh-native-command": "0.2.0-rc.2 || 0.2.1-alpha.4 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.2-alpha.2",
    "koffi": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "koffi": {
      "optional": true
    }
  }
}
