{
  "name": "@deepseek-ai/dsh-experimental-paper-review",
  "version": "0.1.7-alpha.4",
  "description": "Annotation-driven Markdown manuscript review with proposals and human review baselines",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "paper-review",
    "markdown",
    "manuscript",
    "annotations"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Biogod2020/dsh-article-review.git"
  },
  "homepage": "https://github.com/Biogod2020/dsh-article-review#readme",
  "bugs": {
    "url": "https://github.com/Biogod2020/dsh-article-review/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/node-addon-system": "^0.1.2",
    "@deepseek-ai/dsh-native-command": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "diff": "9.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "koffi": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "koffi": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  }
}
