exports[`shows a new paragraph without an empty comparison column 1`] = `"<div><section data-rendered-after="true"><h5>After</h5><div data-find-text="true"><div data-rendered-diff="after"><div><p>A <strong>new</strong> paragraph.</p></div></div></div></section></div><details><summary>View Markdown source diff</summary></details>"`;

