exports[`offers complete before and after text for a reordered sentence 1`] = `"<div><section data-rendered-before="true"><h5>Review baseline</h5><div data-find-text="true"><style>::highlight(paper-diff-R15){background:var(--paper-removed-bg);color:var(--paper-removed);text-decoration:underline 1px var(--paper-removed)}</style><div data-rendered-diff="before"><div><p>Resolving identities is <strong>central</strong> to reusing samples.</p></div></div></div></section><section data-rendered-after="true"><h5>Current version</h5><div data-find-text="true"><style>::highlight(paper-diff-R19){background:var(--paper-added-bg);color:var(--paper-added);text-decoration:underline 1px var(--paper-added)}</style><div data-rendered-diff="after"><div><p>Reusing samples requires resolving identities.</p></div></div></div></section></div><details><summary>View Markdown source diff</summary></details>"`;

