// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders readable Markdown by default and retains source comparison controls 1`] = `"<div data-version-comparison="true"><h3>Compare versions</h3><p>Select any two saved versions. Rendered pages are easier to read; source views show exact Markdown additions and deletions. The manuscript and review baselines stay unchanged.</p><div><label>Left version<select aria-label="Left version"><option value="0" selected="">Version 1 · 2026-09-22 12:00 · revisio</option><option value="1">Version 2 · 2026-09-22 12:00 · revisio</option><option value="2">Version 3 · 2026-09-22 12:00 · revisio</option></select></label><button>Swap</button><label>Right version<select aria-label="Right version"><option value="0">Version 1 · 2026-09-22 12:00 · revisio</option><option value="1">Version 2 · 2026-09-22 12:00 · revisio</option><option value="2" selected="">Version 3 · 2026-09-22 12:00 · revisio</option></select></label></div><div><button aria-pressed="true">Rendered pages</button><button aria-pressed="false">Source side by side</button><button aria-pressed="false">Source inline changes</button><span>Changed words receive color; borders mark changed blocks. Use source views for formatting-only changes.</span></div><div><section data-version-rendered="before"><h4>Version 1 · 2026-09-22 12:00 · revisio</h4><div><div data-reader-text="true"><div><h2>Finding</h2></div></div></div><div><style>::highlight(paper-diff-RaeH1){background:var(--paper-removed-bg);color:var(--paper-removed);text-decoration:underline 1px var(--paper-removed)}</style><div data-reader-text="true"><div><p>Original <strong>claim</strong>.</p></div></div></div></section><section data-version-rendered="after"><h4>Version 3 · 2026-09-22 12:00 · revisio</h4><div><div data-reader-text="true"><div><h2>Finding</h2></div></div></div><div><style>::highlight(paper-diff-RamH1){background:var(--paper-added-bg);color:var(--paper-added);text-decoration:underline 1px var(--paper-added)}</style><div data-reader-text="true"><div><p>Qualified <strong>claim</strong>.</p></div></div></div></section></div></div>"`;

exports[`renders readable Markdown by default and retains source comparison controls 2`] = `"<div data-version-comparison="true"><h3>版本对比</h3><p>选择任意两个已保存版本。渲染视图便于阅读，源码视图显示精确的 Markdown 增删；不会改动稿件或已审状态。</p><div><label>左侧版本<select aria-label="左侧版本"><option value="0" selected="">版本 1 · 2026-09-22 12:00 · revisio</option><option value="1">版本 2 · 2026-09-22 12:00 · revisio</option><option value="2">版本 3 · 2026-09-22 12:00 · revisio</option></select></label><button>交换</button><label>右侧版本<select aria-label="右侧版本"><option value="0">版本 1 · 2026-09-22 12:00 · revisio</option><option value="1">版本 2 · 2026-09-22 12:00 · revisio</option><option value="2" selected="">版本 3 · 2026-09-22 12:00 · revisio</option></select></label></div><div><button aria-pressed="true">渲染后并排</button><button aria-pressed="false">源码并排</button><button aria-pressed="false">源码行内差异</button><span>变化文字会局部着色，边线提示变化的段落；纯格式变化请看源码视图。</span></div><div><section data-version-rendered="before"><h4>版本 1 · 2026-09-22 12:00 · revisio</h4><div><div data-reader-text="true"><div><h2>Finding</h2></div></div></div><div><style>::highlight(paper-diff-RaeH1){background:var(--paper-removed-bg);color:var(--paper-removed);text-decoration:underline 1px var(--paper-removed)}</style><div data-reader-text="true"><div><p>Original <strong>claim</strong>.</p></div></div></div></section><section data-version-rendered="after"><h4>版本 3 · 2026-09-22 12:00 · revisio</h4><div><div data-reader-text="true"><div><h2>Finding</h2></div></div></div><div><style>::highlight(paper-diff-RamH1){background:var(--paper-added-bg);color:var(--paper-added);text-decoration:underline 1px var(--paper-added)}</style><div data-reader-text="true"><div><p>Qualified <strong>claim</strong>.</p></div></div></div></section></div></div>"`;
